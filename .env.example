# Telegram Bot Configuration
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here

# Get your chat ID by messaging your bot and checking:
# https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your-chat-id-here

# Health Monitor Configuration
# Optional: n8n webhook URL for external health reporting
HEALTH_WEBHOOK_URL=https://your-n8n-instance.com/webhook/vibecode-health

# Health check interval in seconds (default: 60)
HEALTH_CHECK_INTERVAL=60

# Web Server Configuration
WEB_SERVER_PORT=8080

# LiteLLM / LLM Configuration (optional)
LITELLM_API_URL=http://localhost:4000
LITELLM_API_KEY=your-litellm-key-here

# LiteLLM Budget Alert Webhook URL (Issue #40)
# Configure this in LiteLLM to receive budget threshold notifications
LITELLM_BUDGET_WEBHOOK_URL=https://your-n8n-instance.com/webhook/litellm-budget

# Monthly budget cap in USD (default: 15)
LITELLM_MONTHLY_BUDGET_USD=15
